# Copy to deploy/.env. Supply independent random secrets; never commit .env.
# Three independent credentials: bootstrap admin, schema owner, data-only runtime.
POSTGRES_PASSWORD=
MIGRATION_DATABASE_PASSWORD=
APP_DATABASE_PASSWORD=
# Optional admin gateway: create its restricted role before enabling the URL.
ADMIN_GATEWAY_DATABASE_PASSWORD=
ADMIN_DATABASE_URL=
ADMIN_AUTH_SECRET=
# New production databases must use UTC. Do not restore non-UTC legacy data
# without converting and verifying its dates on a copy first; see project docs.
DB_TIMEZONE=UTC
DATABASE_URL=postgresql://staffly_app:URL_ENCODED_APP_PASSWORD@postgres:5432/staffly
MIGRATION_DATABASE_URL=postgresql://staffly_migrator:URL_ENCODED_MIGRATION_PASSWORD@postgres:5432/staffly
# Operator-only backup URL; never passed to API/worker. Requires SELECT on all tables.
BACKUP_DATABASE_URL=
# Optional direct/session-pooled URL if DATABASE_URL points to transaction-mode PgBouncer.
LIVE_DATABASE_URL=
# Default is S3. For one-host local files use compose.local-files.yaml as well.
STORAGE_DRIVER=s3
LOCAL_STORAGE_SHARED=false
JWT_SECRET=
INVITE_CODE_SECRET=
APP_ORIGIN=https://your-domain.example
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
SMTP_APP_PASSWORD=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=staffly-private
S3_REGION=us-east-1
# Supply an existing private S3-compatible bucket. Leave endpoint blank for AWS S3.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# Metrics is private to the backend network; use an independent 32+ character token.
METRICS_TOKEN=
# Four APIs share a 3072 MiB V8 heap budget, matching the short scale profile.
# Container limit includes native buffers/runtime in addition to V8 heap.
API_HEAP_MIB=768
API_MEMORY_LIMIT=1536m
WORKER_MEMORY_LIMIT=1536m
# Emergency pause covers both outbox and direct security codes. Recreate APIs/worker.
EMAIL_DELIVERY_PAUSED=false
# Pin matching immutable release tags/digests before deployment/rollback.
APP_IMAGE=staffly:local
MIGRATION_IMAGE=staffly-migrations:local
FILE_PROCESSOR_IMAGE=staffly-file-processor:local
EDGE_IMAGE=staffly-edge:local
# TLS files are mounted read-only; they must be readable by the container's
# nginx user. Keep private-key access limited to that user/group and the operator.
TLS_CERT_PATH=/absolute/path/to/fullchain.pem
TLS_KEY_PATH=/absolute/path/to/privkey.pem
# Set to 0.0.0.0 only after configuring the upstream DDoS service/firewall.
BIND_ADDRESS=127.0.0.1
HTTPS_PORT=443
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=https://your-domain.example/api/auth/yandex/callback

# Release metadata for the protected admin panel (not process uptime).
APP_ENVIRONMENT=production
APP_VERSION=
APP_DEPLOYED_AT=

# Optional operator service; start explicitly with --profile maintenance.
MAINTENANCE_IMAGE=staffly-maintenance:local
ADMIN_MANAGEMENT_DATABASE_URL=
BACKUP_DATABASE_URL=
RESTORE_ADMIN_DATABASE_URL=
# Observer runs on a separate host to survive loss of the application host.
ADMIN_OBSERVER_DATABASE_URL=
ADMIN_OBSERVER_STATE_DIRECTORY=
ADMIN_PROBE_URL=
ADMIN_SIGNAL_WEBHOOK_URL=
ADMIN_SIGNAL_WEBHOOK_TOKEN=
ADMIN_SIGNAL_TELEGRAM_TOKEN=
# Read-only object-store credentials for the maintenance image.
S3_BACKUP_ACCESS_KEY_ID=
S3_BACKUP_SECRET_ACCESS_KEY=
OBSERVER_IMAGE=staffly-observer:local
