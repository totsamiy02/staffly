# Copy to deploy/.env. Supply independent random secrets; never commit .env.
# Three independent credentials: bootstrap admin, schema owner, data-only runtime.
POSTGRES_PASSWORD=
MIGRATION_DATABASE_PASSWORD=
APP_DATABASE_PASSWORD=
# New production databases must use UTC. Do not restore non-UTC legacy data
# without converting and verifying its dates on a copy first; see project docs.
DB_TIMEZONE=UTC
DATABASE_URL=postgresql://staffly_app:URL_ENCODED_APP_PASSWORD@postgres:5432/staffly
MIGRATION_DATABASE_URL=postgresql://staffly_migrator:URL_ENCODED_MIGRATION_PASSWORD@postgres:5432/staffly
# Operator-only backup URL; never passed to API/worker. Requires SELECT on all tables.
BACKUP_DATABASE_URL=
# Optional direct/session-pooled URL if DATABASE_URL points to transaction-mode PgBouncer.
LIVE_DATABASE_URL=
JWT_SECRET=
INVITE_CODE_SECRET=
APP_ORIGIN=https://your-domain.example
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
SMTP_APP_PASSWORD=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=staffly-private
S3_REGION=us-east-1
# Supply an existing private S3-compatible bucket. Leave endpoint blank for AWS S3.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# Metrics is private to the backend network; use an independent 32+ character token.
METRICS_TOKEN=
# Four APIs share a 3072 MiB V8 heap budget, matching the short scale profile.
# Container limit includes native buffers/runtime in addition to V8 heap.
API_HEAP_MIB=768
API_MEMORY_LIMIT=1536m
WORKER_MEMORY_LIMIT=1536m
# TLS files are mounted read-only into the edge container.
TLS_CERT_PATH=/absolute/path/to/fullchain.pem
TLS_KEY_PATH=/absolute/path/to/privkey.pem
# Set to 0.0.0.0 only after configuring the upstream DDoS service/firewall.
BIND_ADDRESS=127.0.0.1
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=https://your-domain.example/api/auth/yandex/callback
