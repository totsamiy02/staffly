generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model DatabaseTimeModel {
  id Int @id
  version String @db.VarChar(16)
  sourceTimezone String? @map("source_timezone")
  convertedAt DateTime? @map("converted_at") @db.Timestamptz(3)
  @@map("app_time_model")
}

model ApiRateLimit {
  key String @id @db.VarChar(64)
  hits Int
  resetAt DateTime @map("reset_at") @db.Timestamptz(3)
  @@index([resetAt])
  @@map("api_rate_limits")
}

model OrganizationResourceBudget {
  organizationId String @id @map("organization_id") @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  storageBytes BigInt @default(0) @map("storage_bytes")
  storageLimitBytes BigInt @default(5368709120) @map("storage_limit_bytes")
  exportQueueLimit Int @default(5) @map("export_queue_limit")
  exportHourLimit Int @default(20) @map("export_hour_limit")
  exportWindowStart DateTime @default(now()) @map("export_window_start") @db.Timestamptz(3)
  exportWindowCount Int @default(0) @map("export_window_count")
  lastExportAt DateTime? @map("last_export_at") @db.Timestamptz(3)
  pendingEmails Int @default(0) @map("pending_emails")
  emailQueueLimit Int @default(2000) @map("email_queue_limit")
  emailMinuteLimit Int @default(60) @map("email_minute_limit")
  emailWindowStart DateTime @default(now()) @map("email_window_start") @db.Timestamptz(3)
  emailWindowCount Int @default(0) @map("email_window_count")
  lastEmailAt DateTime? @map("last_email_at") @db.Timestamptz(3)
  offerCheckCursor String? @map("offer_check_cursor") @db.Uuid
  requestCheckCursor String? @map("request_check_cursor") @db.Uuid
  @@map("organization_resource_budgets")
}

model ReportExport {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  input Json
  inputHash String @map("input_hash") @db.VarChar(64)
  status String @default("PENDING") @db.VarChar(16)
  attempts Int @default(0)
  leaseToken String? @map("lease_token") @db.Uuid
  leaseUntil DateTime? @map("lease_until") @db.Timestamptz(3)
  objectKey String? @map("object_key") @db.VarChar(512)
  errorCode String? @map("error_code") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId, status, leaseUntil], map: "report_exports_org_active_idx")
  @@index([status, leaseUntil, createdAt])
  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("report_exports")
}

model AuthAttemptLimit {
  key       String   @id @db.VarChar(64)
  attempts  Int      @default(0)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("auth_attempt_limits")
}

model User {
  subscriptionPurchases SubscriptionPurchase[]
  reportExports ReportExport[]
  id                  String    @id @default(uuid()) @db.Uuid
  email               String    @unique @db.VarChar(254)
  passwordHash        String?   @map("password_hash") @db.Text
  termsAcceptedAt     DateTime? @map("terms_accepted_at") @db.Timestamptz(3)
  dataConsentAt       DateTime? @map("data_consent_at") @db.Timestamptz(3)
  securityVersion     Int       @default(0) @map("security_version")
  emailVerifiedAt     DateTime? @map("email_verified_at") @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(3)
  lastSecurityEmailAt DateTime? @map("last_security_email_at") @db.Timestamptz(3)
  firstName           String?   @map("first_name") @db.VarChar(80)
  lastName            String?   @map("last_name") @db.VarChar(80)
  middleName          String?   @map("middle_name") @db.VarChar(80)
  phone               String?   @db.VarChar(12)
  bio                 String?   @db.VarChar(500)
  lastSeenAt          DateTime? @map("last_seen_at") @db.Timestamptz(3)
  avatarFileId        String?   @unique @map("avatar_file_id") @db.Uuid
  emailNotificationsEnabled Boolean @default(true) @map("email_notifications_enabled")
  emailNotificationCategories Json @default("{\"shiftChanges\":true,\"publishedSchedule\":true,\"shiftOffers\":true,\"scheduleDiscussion\":true,\"requestResults\":true,\"documents\":true,\"importantEvents\":true}") @map("email_notification_categories")
  emailPreferencesRevision Int @default(0) @map("email_preferences_revision")
  emailDeliveries EmailDelivery[]

  sessions                 AuthSession[]
  identities               AuthIdentity[]
  oauthAttempts            OAuthAttempt[]
  emailChangeTokens        EmailChangeToken[]
  emailVerificationTokens  EmailVerificationToken[]
  passwordResetTokens      PasswordResetToken[]
  createdOrganizations     Organization[]           @relation("OrganizationCreator")
  organizationMemberships  OrganizationMember[]
  organizationInvites      OrganizationInvite[]     @relation("InvitationCreator")
  acceptedInvites          OrganizationInvite[]     @relation("InvitationAcceptor")
  sensitiveActions         SensitiveActionToken[]   @relation("SensitiveActionOwner")
  targetedSensitiveActions SensitiveActionToken[]   @relation("SensitiveActionTarget")
  accountNotifications     AccountNotification[]
  documentFolderPins       DocumentFolderPin[]
  avatar                   StoredFile?              @relation("UserAvatar", fields: [avatarFileId], references: [id], onDelete: SetNull)
  uploadedFiles            StoredFile[]             @relation("FileUploader")

  @@index([lastSeenAt])
  @@map("users")
}

model AuthIdentity {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  provider    String   @db.VarChar(24)
  subject     String   @db.VarChar(128)
  email       String   @db.VarChar(254)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastLoginAt DateTime @default(now()) @map("last_login_at") @db.Timestamptz(3)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@unique([userId, provider])
  @@map("auth_identities")
}

// Short-lived, browser-bound OAuth handshakes. Provider tokens are never stored.
model OAuthAttempt {
  id           String   @id @default(uuid()) @db.Uuid
  stateHash    String   @unique @map("state_hash") @db.VarChar(64)
  browserHash  String   @map("browser_hash") @db.VarChar(64)
  codeVerifier String?  @map("code_verifier") @db.VarChar(128)
  stage        String   @default("STARTED") @db.VarChar(20)
  purpose      String   @default("LOGIN") @db.VarChar(24)
  securityVersion Int?   @map("security_version")
  returnTo     String   @map("return_to") @db.VarChar(2048)
  userId       String?  @map("user_id") @db.Uuid
  sessionId    String?  @map("session_id") @db.Uuid
  profile      Json?
  attempts     Int      @default(0)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("oauth_attempts")
}

model EmailChangeToken {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  sessionId       String    @map("session_id") @db.Uuid
  email           String    @db.VarChar(254)
  codeHash        String    @map("code_hash") @db.VarChar(64)
  securityVersion Int       @map("security_version")
  attempts        Int       @default(0)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt          DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([expiresAt])
  @@map("email_change_tokens")
}

model EmailDelivery {
  skipReason String? @map("skip_reason") @db.VarChar(40)
  eventOrder BigInt @default(autoincrement()) @map("event_order")
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String? @map("organization_id") @db.Uuid
  sourceKey String @unique @map("source_key") @db.VarChar(240)
  sourceKind String @map("source_kind") @db.VarChar(32)
  sourceId String? @map("source_id") @db.Uuid
  category String? @db.VarChar(40)
  recipientEmail String? @map("recipient_email") @db.VarChar(254)
  payload Json @default("{}")
  status String @default("PENDING") @db.VarChar(16)
  attempts Int @default(0)
  availableAt DateTime @default(now()) @map("available_at") @db.Timestamptz(3)
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz(3)
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@index([organizationId, status, lockedUntil], map: "email_deliveries_org_active_idx")
  @@index([status, availableAt])
  @@index([userId, category])
  @@map("email_deliveries")
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum OrganizationInviteType {
  EMAIL
  CODE
}

enum SensitiveActionType {
  TRANSFER_OWNERSHIP
  DELETE_ORGANIZATION
  ARCHIVE_LOCATION
}

enum WorkShiftStatus {
  SCHEDULED
  CANCELLED
}

enum AccountNotificationType {
  SUBSCRIPTION_STATUS
  REQUEST_VACATION_COLLECTION
  REQUEST_VACATION_REMINDER
  SCHEDULE_DISCUSSION
  ABSENCE_REPORTED
  ABSENCE_CHANGED
  ABSENCE_CANCELLED
  SHIFT_ASSIGNED
  SHIFT_CHANGED
  SHIFT_CANCELLED
  ROLE_CHANGED
  REQUEST_CREATED
  REQUEST_APPROVED
  REQUEST_REJECTED
  REQUEST_CANCELLED
  DOCUMENT_ASSIGNED
  EVENT_PUBLISHED
  EVENT_CHANGED
  EVENT_CANCELLED
  EVENT_STARTED
  SHIFT_OFFER_CREATED
  SHIFT_OFFER_APPROVAL
  SHIFT_OFFER_RESULT
}

enum RequestSystemCode {
  SICK
  VACATION
  DAY_OFF
  SICK_LEAVE
  ABSENCE
  SHIFT_CHANGE
  SHIFT_PROPOSAL
  STAFFING
  STAFFING_RESPONSE
  OTHER
}

enum RequestDateMode {
  NONE
  SINGLE
  RANGE
}

enum RequestStatus {
  DRAFT
  RETURNED
  REGISTERED
  EXPIRED
  INVALID
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum RequestEventType {
  SUBMITTED
  RETURNED
  STAGE_APPROVED
  CHANGED
  EXPIRED
  INVALID
  CREATED
  EDITED
  APPROVED
  REJECTED
  CANCELLED
}

model Organization {
  subscription OrganizationSubscription?
  subscriptionPurchases SubscriptionPurchase[]
  resourceBudget OrganizationResourceBudget?
  reportExports ReportExport[]
  vacationStandardDays Int @default(28) @map("vacation_standard_days")
  vacationHolidays String[] @default([]) @map("vacation_holidays")
  coverageEnabled Boolean @default(false) @map("coverage_enabled")
  discussionEnabled Boolean @default(false) @map("discussion_enabled")
  demandVersions DemandVersion[]
  demandExceptions DemandException[]
  scheduleDrafts ScheduleDraft[]
  id                 String                 @id @default(uuid()) @db.Uuid
  name               String                 @db.VarChar(120)
  description        String?                @db.VarChar(1000)
  timezone           String                 @db.VarChar(64)
  createdByUserId    String                 @map("created_by_user_id") @db.Uuid
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime?              @map("deleted_at") @db.Timestamptz(3)
  contactEmail       String?                @map("contact_email") @db.VarChar(254)
  phone              String?                @db.VarChar(12)
  website            String?                @db.VarChar(2048)
  address            String?                @db.VarChar(300)
  monthlyWorkMinutes Int?                   @map("monthly_work_minutes")
  locations          OrganizationLocation[]
  locationTransfers  LocationTransfer[]
  positions          OrganizationPosition[]
  shiftTemplates     ShiftTemplate[]
  logoFileId         String?                @unique @map("logo_file_id") @db.Uuid

  createdBy            User                   @relation("OrganizationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  logo                 StoredFile?            @relation("OrganizationLogo", fields: [logoFileId], references: [id], onDelete: SetNull)
  files                StoredFile[]           @relation("OrganizationFiles")
  accessRoles          AccessRole[]
  accessAudit          AccessAudit[]
  members              OrganizationMember[]
  invitations          OrganizationInvite[]
  sensitiveActions     SensitiveActionToken[]
  workShifts           WorkShift[]
  accountNotifications AccountNotification[]
  vacationCampaigns VacationCampaign[]
  requestTypes         RequestType[]
  requests             OrganizationRequest[]
  absences             EmployeeAbsence[]
  documents            Document[]
  documentFolders      DocumentFolder[]
  events               OrganizationEvent[]

  shiftTransferMode    ShiftOfferMode         @default(DISABLED) @map("shift_transfer_mode")
  shiftSwapMode        ShiftOfferMode         @default(DISABLED) @map("shift_swap_mode")
  shiftOffers          ShiftOffer[]
  reportTemplates      ReportTemplate[]

  @@index([createdByUserId])
  @@index([deletedAt])
  @@map("organizations")
}

enum StoredFilePurpose {
  USER_AVATAR
  ORGANIZATION_LOGO
  REQUEST_ATTACHMENT
  DOCUMENT
}

model StoredFile {
  id                String            @id @default(uuid()) @db.Uuid
  objectKey         String            @unique @map("object_key") @db.VarChar(500)
  mimeType          String            @map("mime_type") @db.VarChar(100)
  size              Int
  checksumSha256    String            @map("checksum_sha256") @db.Char(64)
  purpose           StoredFilePurpose
  uploadedByUserId  String            @map("uploaded_by_user_id") @db.Uuid
  organizationId    String?           @map("organization_id") @db.Uuid
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  pendingDeletionAt DateTime?         @map("pending_deletion_at") @db.Timestamptz(3)
  purgedAt          DateTime?         @map("purged_at") @db.Timestamptz(3)
  deletionAttempts  Int               @default(0) @map("deletion_attempts")
  lastDeletionError String?           @map("last_deletion_error") @db.VarChar(500)

  uploadedBy        User               @relation("FileUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  organization      Organization?      @relation("OrganizationFiles", fields: [organizationId], references: [id], onDelete: Cascade)
  userAvatar        User?              @relation("UserAvatar")
  organizationLogo  Organization?      @relation("OrganizationLogo")
  document          Document?
  requestAttachment RequestAttachment?

  @@index([uploadedByUserId])
  @@index([organizationId])
  @@index([pendingDeletionAt])
  @@map("stored_files")
}

model AccountNotification {
  subscriptionDeliveryKey String? @unique @map("subscription_delivery_key") @db.VarChar(200)
  vacationCampaignId String? @map("vacation_campaign_id") @db.Uuid
  vacationCampaign VacationCampaign? @relation(fields: [organizationId,vacationCampaignId], references: [organizationId,id], onDelete: Cascade)
  scheduleDraftId String? @map("schedule_draft_id") @db.Uuid
  scheduleDraft ScheduleDraft? @relation(fields: [organizationId, scheduleDraftId], references: [organizationId, id], onDelete: Cascade)
  eventId String? @map("event_id") @db.Uuid
  eventDeliveryKey String? @unique @map("event_delivery_key") @db.VarChar(200)
  event OrganizationEvent? @relation(fields: [organizationId, eventId], references: [organizationId, id], onDelete: Cascade)
  hiddenAt DateTime? @map("hidden_at") @db.Timestamptz(3)
  documentId String? @map("document_id") @db.Uuid
  document Document? @relation(fields: [documentId], references: [id], onDelete: Restrict)
  absenceId String? @map("absence_id") @db.Uuid
  absence EmployeeAbsence? @relation(fields: [absenceId], references: [id], onDelete: SetNull)
  id               String                  @id @default(uuid()) @db.Uuid
  userId           String                  @map("user_id") @db.Uuid
  organizationId   String                  @map("organization_id") @db.Uuid
  requestId        String?                 @map("request_id") @db.Uuid
  shiftId          String?                 @map("shift_id") @db.Uuid
  emailAttemptedAt DateTime?               @map("email_attempted_at") @db.Timestamptz(3)
  emailContext Json? @map("email_context")
  type             AccountNotificationType
  title            String                  @db.VarChar(160)
  message          String                  @db.VarChar(500)
  readAt           DateTime?               @map("read_at") @db.Timestamptz(3)
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  request      OrganizationRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  shift        WorkShift?           @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  shiftOfferId          String?                 @map("shift_offer_id") @db.Uuid
  shiftOfferDeliveryKey String?                 @unique @map("shift_offer_delivery_key") @db.VarChar(200)
  shiftOffer            ShiftOffer?             @relation(fields: [organizationId, shiftOfferId], references: [organizationId, id], onDelete: Cascade)

  @@index([eventId])
  @@index([documentId])
  @@index([absenceId])
  @@index([userId, readAt, createdAt])
  @@index([userId, createdAt, id])
  @@index([shiftId])
  @@index([userId, organizationId, emailAttemptedAt], map: "account_notifications_user_id_organization_id_email_attempted_i")
  @@index([organizationId])
  @@index([requestId])
  @@map("account_notifications")
}

model OrganizationMember {
  authoredDrafts ScheduleDraft[] @relation("DraftAuthor")
  draftRecipients DraftRecipient[]
  draftComments DraftComment[]
  draftHistory DraftHistory[]
  accessConfigured Boolean @default(false) @map("access_configured")
  accessRoleId String? @map("access_role_id") @db.Uuid
  accessRole AccessRole? @relation(fields: [organizationId, accessRoleId], references: [organizationId, id], onDelete: Restrict)
  accessAssignments AccessAssignment[]
  personnelNumber String? @map("personnel_number") @db.VarChar(32)
  reportTemplates ReportTemplate[]
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           OrganizationRole @default(MEMBER)
  joinedAt       DateTime         @default(now()) @map("joined_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  leftAt         DateTime?        @map("left_at") @db.Timestamptz(3)

  createdEvents OrganizationEvent[] @relation("EventCreator")
  updatedEvents OrganizationEvent[] @relation("EventEditor")
  eventRecipients EventRecipient[]
  eventChanges EventChange[]
  locationMemberships LocationMember[]
  teamMemberships     LocationTeamMember[]
  locationTransfers   LocationTransfer[] @relation("TransferredMember")
  authoredTransfers   LocationTransfer[] @relation("TransferAuthor")
  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  positions           MemberPosition[]
  workShifts          WorkShift[]           @relation("ShiftEmployee")
  createdWorkShifts   WorkShift[]           @relation("ShiftCreator")
  cancelledWorkShifts WorkShift[]           @relation("ShiftCanceller")
  shiftAdjustments    WorkShiftAdjustment[] @relation("ShiftAdjustmentAuthor")
  createdRequests     OrganizationRequest[] @relation("RequestCreator")
  resolvedRequests    OrganizationRequest[] @relation("RequestResolver")
  requestReads        RequestRead[]
  requestEvents       RequestEvent[]
  absences            EmployeeAbsence[]
  uploadedDocuments   Document[] @relation("DocumentUploader")
  personalDocuments   Document[] @relation("DocumentTarget")
  documentAcknowledgements DocumentAcknowledgement[] @relation("AcknowledgementRecipient")
  assignedAcknowledgements DocumentAcknowledgement[] @relation("AcknowledgementAssigner")

  initiatedShiftOffers     ShiftOffer[]              @relation("OfferInitiator")
  receivedShiftOffers      ShiftOffer[]              @relation("OfferRecipient")
  acceptedShiftOffers      ShiftOffer[]              @relation("OfferAcceptor")
  reviewedShiftOffers      ShiftOffer[]              @relation("OfferReviewer")

  @@unique([organizationId, userId])
  @@unique([organizationId, personnelNumber])
  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([userId])
  @@index([organizationId, role])
  @@index([organizationId, leftAt])
  @@map("organization_members")
}

model ReportTemplate {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  createdByMemberId String @map("created_by_member_id") @db.Uuid
  name String @db.VarChar(80)
  config Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy OrganizationMember @relation(fields: [organizationId, createdByMemberId], references: [organizationId, id], onDelete: Cascade)
  @@index([organizationId])
  @@map("report_templates")
}

enum ShiftAttendance {
  UNCONFIRMED
  WORKED
  PARTIAL
  NO_SHOW
}

model WorkShift {
  attendance ShiftAttendance @default(UNCONFIRMED)
  attendanceReason String? @map("attendance_reason") @db.VarChar(500)
  locationId String @map("location_id") @db.Uuid
  location OrganizationLocation @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)
  id                   String                @id @default(uuid()) @db.Uuid
  organizationId       String                @map("organization_id") @db.Uuid
  memberId             String                @map("member_id") @db.Uuid
  createdByMemberId    String                @map("created_by_member_id") @db.Uuid
  scheduledStartAt     DateTime              @map("scheduled_start_at") @db.Timestamptz(3)
  scheduledEndAt       DateTime              @map("scheduled_end_at") @db.Timestamptz(3)
  breakMinutes         Int                   @default(0) @map("break_minutes")
  actualStartAt        DateTime?             @map("actual_start_at") @db.Timestamptz(3)
  actualEndAt          DateTime?             @map("actual_end_at") @db.Timestamptz(3)
  actualBreakMinutes   Int?                  @map("actual_break_minutes")
  positionId           String?               @map("position_id") @db.Uuid
  positionNameSnapshot String?               @map("position_name_snapshot") @db.VarChar(120)
  position             OrganizationPosition? @relation(fields: [positionId], references: [id], onDelete: SetNull)
  description          String?               @db.VarChar(500)
  status               WorkShiftStatus       @default(SCHEDULED)
  cancelledAt          DateTime?             @map("cancelled_at") @db.Timestamptz(3)
  cancelledByMemberId  String?               @map("cancelled_by_member_id") @db.Uuid
  cancellationReason   String?               @map("cancellation_reason") @db.VarChar(500)
  assignmentReadAt     DateTime?             @map("assignment_read_at") @db.Timestamptz(3)
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member            OrganizationMember    @relation("ShiftEmployee", fields: [memberId], references: [id], onDelete: Restrict)
  createdByMember   OrganizationMember    @relation("ShiftCreator", fields: [createdByMemberId], references: [id], onDelete: Restrict)
  cancelledByMember OrganizationMember?   @relation("ShiftCanceller", fields: [cancelledByMemberId], references: [id], onDelete: Restrict)
  adjustments       WorkShiftAdjustment[]
  changeRequests    OrganizationRequest[]
  notifications     AccountNotification[]

