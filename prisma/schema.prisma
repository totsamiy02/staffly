enum DocumentVisibility {
  ORGANIZATION
  ADMINS
  PRIVATE_MEMBER
}

model DocumentFolder {
  visibility DocumentVisibility @default(ORGANIZATION)
  locationId String? @map("location_id") @db.Uuid
  location OrganizationLocation? @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  parentId String? @map("parent_id") @db.Uuid
  name String @db.VarChar(160)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  parent DocumentFolder? @relation("FolderTree", fields: [parentId], references: [id], onDelete: Restrict)
  children DocumentFolder[] @relation("FolderTree")
  documents Document[]
  pins DocumentFolderPin[]
  @@index([organizationId, parentId])
  @@map("document_folders")
  @@index([organizationId, locationId])
}

model DocumentFolderPin {
  userId String @map("user_id") @db.Uuid
  folderId String @map("folder_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder DocumentFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  @@id([userId, folderId])
  @@index([folderId])
  @@map("document_folder_pins")
}

model Document {
  locationId String? @map("location_id") @db.Uuid
  location OrganizationLocation? @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  storedFileId String @unique @map("stored_file_id") @db.Uuid
  folderId String? @map("folder_id") @db.Uuid
  displayName String @map("display_name") @db.VarChar(255)
  fileName String @map("file_name") @db.VarChar(255)
  visibility DocumentVisibility
  uploadedByMemberId String @map("uploaded_by_member_id") @db.Uuid
  targetMemberId String? @map("target_member_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  storedFile StoredFile @relation(fields: [storedFileId], references: [id], onDelete: Restrict)
  folder DocumentFolder? @relation(fields: [folderId], references: [id], onDelete: Restrict)
  uploadedBy OrganizationMember @relation("DocumentUploader", fields: [uploadedByMemberId], references: [id], onDelete: Restrict)
  targetMember OrganizationMember? @relation("DocumentTarget", fields: [targetMemberId], references: [id], onDelete: Restrict)
  acknowledgements DocumentAcknowledgement[]
  notifications AccountNotification[]
  @@index([organizationId, deletedAt, folderId, createdAt])
  @@index([organizationId, targetMemberId, deletedAt])
  @@map("documents")
  @@index([organizationId, locationId])
}

model DocumentAcknowledgement {
  id String @id @default(uuid()) @db.Uuid
  documentId String @map("document_id") @db.Uuid
  memberId String @map("member_id") @db.Uuid
  assignedByMemberId String @map("assigned_by_member_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)
  openedAt DateTime? @map("opened_at") @db.Timestamptz(3)
  acknowledgedAt DateTime? @map("acknowledged_at") @db.Timestamptz(3)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(3)
  deadline DateTime? @db.Date
  comment String? @db.VarChar(1000)
  document Document @relation(fields: [documentId], references: [id], onDelete: Restrict)
  member OrganizationMember @relation("AcknowledgementRecipient", fields: [memberId], references: [id], onDelete: Restrict)
  assignedBy OrganizationMember @relation("AcknowledgementAssigner", fields: [assignedByMemberId], references: [id], onDelete: Restrict)
  @@unique([documentId, memberId])
  @@index([memberId, acknowledgedAt, cancelledAt])
  @@index([documentId, cancelledAt, acknowledgedAt])
  @@map("document_acknowledgements")
}


enum LocationRole {
  ADMIN
  MEMBER
}

model OrganizationLocation {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  name String @db.VarChar(120)
  city String @db.VarChar(120)
  address String @db.VarChar(300)
  timezone String @db.VarChar(64)
  monthlyWorkMinutes Int? @map("monthly_work_minutes")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members LocationMember[]
  teams LocationTeam[]
  shifts WorkShift[]
  requests OrganizationRequest[]
  templates ShiftTemplate[]
  invitations OrganizationInvite[]
  documents Document[]
  folders DocumentFolder[]
  eventLocations EventLocation[]
  transfersFrom LocationTransfer[] @relation("TransferFrom")
  transfersTo LocationTransfer[] @relation("TransferTo")
  @@unique([organizationId, id])
  @@index([organizationId, archivedAt])
  @@map("organization_locations")
}

model LocationMember {
  organizationId String @map("organization_id") @db.Uuid
  locationId String @map("location_id") @db.Uuid
  memberId String @map("member_id") @db.Uuid
  role LocationRole @default(MEMBER)
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz(3)
  leftAt DateTime? @map("left_at") @db.Timestamptz(3)
  location OrganizationLocation @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Cascade)
  member OrganizationMember @relation(fields: [organizationId, memberId], references: [organizationId, id], onDelete: Cascade)
  @@id([locationId, memberId])
  @@index([memberId, leftAt])
  @@map("location_members")
}

model LocationTeam {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  locationId String @map("location_id") @db.Uuid
  name String @db.VarChar(120)
  location OrganizationLocation @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Cascade)
  members LocationTeamMember[]
  @@unique([organizationId, id])
  @@unique([locationId, name])
  @@map("location_teams")
}

model LocationTeamMember {
  organizationId String @map("organization_id") @db.Uuid
  teamId String @map("team_id") @db.Uuid
  memberId String @map("member_id") @db.Uuid
  team LocationTeam @relation(fields: [organizationId, teamId], references: [organizationId, id], onDelete: Cascade)
  member OrganizationMember @relation(fields: [organizationId, memberId], references: [organizationId, id], onDelete: Cascade)
  @@id([teamId, memberId])
  @@map("location_team_members")
}

model LocationTransfer {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  memberId String @map("member_id") @db.Uuid
  createdByMemberId String @map("created_by_member_id") @db.Uuid
  fromLocationId String @map("from_location_id") @db.Uuid
  toLocationId String @map("to_location_id") @db.Uuid
  temporary Boolean @default(false)
  startAt DateTime @map("start_at") @db.Timestamptz(3)
  endAt DateTime? @map("end_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member OrganizationMember @relation("TransferredMember", fields: [organizationId, memberId], references: [organizationId, id], onDelete: Cascade)
  createdBy OrganizationMember @relation("TransferAuthor", fields: [organizationId, createdByMemberId], references: [organizationId, id], onDelete: Restrict)
  fromLocation OrganizationLocation @relation("TransferFrom", fields: [organizationId, fromLocationId], references: [organizationId, id], onDelete: Restrict)
  toLocation OrganizationLocation @relation("TransferTo", fields: [organizationId, toLocationId], references: [organizationId, id], onDelete: Restrict)
  @@index([organizationId, toLocationId, memberId, startAt])
  @@map("location_transfers")
}


enum EventAudienceMode {
  ALL
  ROLES
  SELECTED
}

model OrganizationEvent {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  title String @db.VarChar(160)
  description String? @db.VarChar(4000)
  typeLabel String? @map("type_label") @db.VarChar(80)
  startAt DateTime @map("start_at") @db.Timestamptz(3)
  endAt DateTime? @map("end_at") @db.Timestamptz(3)
  timezone String @db.VarChar(64)
  place String? @db.VarChar(300)
  meetingUrl String? @map("meeting_url") @db.VarChar(2048)
  shared Boolean @default(false)
  audienceMode EventAudienceMode @map("audience_mode")
  audienceRoles LocationRole[] @default([]) @map("audience_roles")
  createdByMemberId String @map("created_by_member_id") @db.Uuid
  updatedByMemberId String @map("updated_by_member_id") @db.Uuid
  revision Int @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(3)
  startNotifiedAt DateTime? @map("start_notified_at") @db.Timestamptz(3)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy OrganizationMember @relation("EventCreator", fields: [organizationId, createdByMemberId], references: [organizationId, id], onDelete: Restrict)
  updatedBy OrganizationMember @relation("EventEditor", fields: [organizationId, updatedByMemberId], references: [organizationId, id], onDelete: Restrict)
  locations EventLocation[]
  recipients EventRecipient[]
  changes EventChange[]
  notifications AccountNotification[]
  @@unique([organizationId, id])
  @@index([organizationId, startAt, id])
  @@index([cancelledAt, startNotifiedAt, startAt])
  @@map("organization_events")
}

model EventLocation {
  organizationId String @map("organization_id") @db.Uuid
  eventId String @map("event_id") @db.Uuid
  locationId String @map("location_id") @db.Uuid
  event OrganizationEvent @relation(fields: [organizationId, eventId], references: [organizationId, id], onDelete: Cascade)
  location OrganizationLocation @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)
  @@id([eventId, locationId])
  @@index([organizationId, locationId])
  @@map("event_locations")
}

model EventRecipient {
  organizationId String @map("organization_id") @db.Uuid
  eventId String @map("event_id") @db.Uuid
  memberId String @map("member_id") @db.Uuid
  addedAt DateTime @default(now()) @map("added_at") @db.Timestamptz(3)
  removedAt DateTime? @map("removed_at") @db.Timestamptz(3)
  event OrganizationEvent @relation(fields: [organizationId, eventId], references: [organizationId, id], onDelete: Cascade)
  member OrganizationMember @relation(fields: [organizationId, memberId], references: [organizationId, id], onDelete: Cascade)
  @@id([eventId, memberId])
  @@index([memberId, removedAt])
  @@map("event_recipients")
}

model EventChange {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  eventId String @map("event_id") @db.Uuid
  memberId String @map("member_id") @db.Uuid
  revision Int
  action String @db.VarChar(20)
  snapshot Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  event OrganizationEvent @relation(fields: [organizationId, eventId], references: [organizationId, id], onDelete: Cascade)
  member OrganizationMember @relation(fields: [organizationId, memberId], references: [organizationId, id], onDelete: Restrict)
  @@unique([eventId, revision])
  @@map("event_changes")
}
