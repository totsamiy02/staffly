generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  email               String    @unique @db.VarChar(254)
  passwordHash        String    @map("password_hash") @db.Text
  emailVerifiedAt     DateTime? @map("email_verified_at") @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(3)
  lastSecurityEmailAt DateTime? @map("last_security_email_at") @db.Timestamptz(3)
  firstName           String?   @map("first_name") @db.VarChar(80)
  lastName            String?   @map("last_name") @db.VarChar(80)
  middleName          String?   @map("middle_name") @db.VarChar(80)
  phone               String?   @db.VarChar(12)
  bio                 String?   @db.VarChar(500)
  lastSeenAt          DateTime? @map("last_seen_at") @db.Timestamptz(3)
  avatarFileId        String?   @unique @map("avatar_file_id") @db.Uuid

  sessions                 AuthSession[]
  emailVerificationTokens  EmailVerificationToken[]
  passwordResetTokens      PasswordResetToken[]
  createdOrganizations     Organization[]           @relation("OrganizationCreator")
  organizationMemberships  OrganizationMember[]
  organizationInvites      OrganizationInvite[]     @relation("InvitationCreator")
  acceptedInvites          OrganizationInvite[]     @relation("InvitationAcceptor")
  sensitiveActions         SensitiveActionToken[]   @relation("SensitiveActionOwner")
  targetedSensitiveActions SensitiveActionToken[]   @relation("SensitiveActionTarget")
  accountNotifications     AccountNotification[]
  documentFolderPins       DocumentFolderPin[]
  avatar                   StoredFile?              @relation("UserAvatar", fields: [avatarFileId], references: [id], onDelete: SetNull)
  uploadedFiles            StoredFile[]             @relation("FileUploader")

  @@index([lastSeenAt])
  @@map("users")
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum OrganizationInviteType {
  EMAIL
  CODE
}

enum SensitiveActionType {
  TRANSFER_OWNERSHIP
  DELETE_ORGANIZATION
  ARCHIVE_LOCATION
}

enum WorkShiftStatus {
  SCHEDULED
  CANCELLED
}

enum AccountNotificationType {
  ABSENCE_REPORTED
  ABSENCE_CHANGED
  ABSENCE_CANCELLED
  SHIFT_ASSIGNED
  SHIFT_CHANGED
  SHIFT_CANCELLED
  ROLE_CHANGED
  REQUEST_CREATED
  REQUEST_APPROVED
  REQUEST_REJECTED
  REQUEST_CANCELLED
  DOCUMENT_ASSIGNED
  EVENT_PUBLISHED
  EVENT_CHANGED
  EVENT_CANCELLED
  EVENT_STARTED
}

enum RequestSystemCode {
  SICK
  VACATION
  DAY_OFF
  SICK_LEAVE
  ABSENCE
  SHIFT_CHANGE
  SHIFT_PROPOSAL
  STAFFING
  STAFFING_RESPONSE
  OTHER
}

enum RequestDateMode {
  NONE
  SINGLE
  RANGE
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum RequestEventType {
  CREATED
  EDITED
  APPROVED
  REJECTED
  CANCELLED
}

model Organization {
  id                 String                 @id @default(uuid()) @db.Uuid
  name               String                 @db.VarChar(120)
  description        String?                @db.VarChar(1000)
  timezone           String                 @db.VarChar(64)
  createdByUserId    String                 @map("created_by_user_id") @db.Uuid
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime?              @map("deleted_at") @db.Timestamptz(3)
  contactEmail       String?                @map("contact_email") @db.VarChar(254)
  phone              String?                @db.VarChar(12)
  website            String?                @db.VarChar(2048)
  address            String?                @db.VarChar(300)
  monthlyWorkMinutes Int?                   @map("monthly_work_minutes")
  locations          OrganizationLocation[]
  locationTransfers  LocationTransfer[]
  positions          OrganizationPosition[]
  shiftTemplates     ShiftTemplate[]
  logoFileId         String?                @unique @map("logo_file_id") @db.Uuid

  createdBy            User                   @relation("OrganizationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  logo                 StoredFile?            @relation("OrganizationLogo", fields: [logoFileId], references: [id], onDelete: SetNull)
  files                StoredFile[]           @relation("OrganizationFiles")
  members              OrganizationMember[]
  invitations          OrganizationInvite[]
  sensitiveActions     SensitiveActionToken[]
  workShifts           WorkShift[]
  accountNotifications AccountNotification[]
  requestTypes         RequestType[]
  requests             OrganizationRequest[]
  absences             EmployeeAbsence[]
  documents            Document[]
  documentFolders      DocumentFolder[]
  events               OrganizationEvent[]

  @@index([createdByUserId])
  @@index([deletedAt])
  @@map("organizations")
}

enum StoredFilePurpose {
  USER_AVATAR
  ORGANIZATION_LOGO
  REQUEST_ATTACHMENT
  DOCUMENT
}

model StoredFile {
  id                String            @id @default(uuid()) @db.Uuid
  objectKey         String            @unique @map("object_key") @db.VarChar(500)
  mimeType          String            @map("mime_type") @db.VarChar(100)
  size              Int
  checksumSha256    String            @map("checksum_sha256") @db.Char(64)
  purpose           StoredFilePurpose
  uploadedByUserId  String            @map("uploaded_by_user_id") @db.Uuid
  organizationId    String?           @map("organization_id") @db.Uuid
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  pendingDeletionAt DateTime?         @map("pending_deletion_at") @db.Timestamptz(3)
  deletionAttempts  Int               @default(0) @map("deletion_attempts")
  lastDeletionError String?           @map("last_deletion_error") @db.VarChar(500)

  uploadedBy        User               @relation("FileUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  organization      Organization?      @relation("OrganizationFiles", fields: [organizationId], references: [id], onDelete: Cascade)
  userAvatar        User?              @relation("UserAvatar")
  organizationLogo  Organization?      @relation("OrganizationLogo")
  document          Document?
  requestAttachment RequestAttachment?

  @@index([uploadedByUserId])
  @@index([organizationId])
  @@index([pendingDeletionAt])
  @@map("stored_files")
}

model AccountNotification {
  eventId String? @map("event_id") @db.Uuid
  eventDeliveryKey String? @unique @map("event_delivery_key") @db.VarChar(200)
  event OrganizationEvent? @relation(fields: [organizationId, eventId], references: [organizationId, id], onDelete: Cascade)
  hiddenAt DateTime? @map("hidden_at") @db.Timestamptz(3)
  documentId String? @map("document_id") @db.Uuid
  document Document? @relation(fields: [documentId], references: [id], onDelete: Restrict)
  absenceId String? @map("absence_id") @db.Uuid
  absence EmployeeAbsence? @relation(fields: [absenceId], references: [id], onDelete: SetNull)
  id               String                  @id @default(uuid()) @db.Uuid
  userId           String                  @map("user_id") @db.Uuid
  organizationId   String                  @map("organization_id") @db.Uuid
  requestId        String?                 @map("request_id") @db.Uuid
  shiftId          String?                 @map("shift_id") @db.Uuid
  emailAttemptedAt DateTime?               @map("email_attempted_at") @db.Timestamptz(3)
  type             AccountNotificationType
  title            String                  @db.VarChar(160)
  message          String                  @db.VarChar(500)
  readAt           DateTime?               @map("read_at") @db.Timestamptz(3)
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  request      OrganizationRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  shift        WorkShift?           @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([documentId])
  @@index([absenceId])
  @@index([userId, readAt, createdAt])
  @@index([userId, createdAt, id])
  @@index([shiftId])
  @@index([userId, organizationId, emailAttemptedAt], map: "account_notifications_user_id_organization_id_email_attempted_i")
  @@index([organizationId])
  @@index([requestId])
  @@map("account_notifications")
}

model OrganizationMember {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           OrganizationRole @default(MEMBER)
  joinedAt       DateTime         @default(now()) @map("joined_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  leftAt         DateTime?        @map("left_at") @db.Timestamptz(3)

  createdEvents OrganizationEvent[] @relation("EventCreator")
  updatedEvents OrganizationEvent[] @relation("EventEditor")
  eventRecipients EventRecipient[]
  eventChanges EventChange[]
  locationMemberships LocationMember[]
  teamMemberships     LocationTeamMember[]
  locationTransfers   LocationTransfer[] @relation("TransferredMember")
  authoredTransfers   LocationTransfer[] @relation("TransferAuthor")
  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  positions           MemberPosition[]
  workShifts          WorkShift[]           @relation("ShiftEmployee")
  createdWorkShifts   WorkShift[]           @relation("ShiftCreator")
  cancelledWorkShifts WorkShift[]           @relation("ShiftCanceller")
  shiftAdjustments    WorkShiftAdjustment[] @relation("ShiftAdjustmentAuthor")
  createdRequests     OrganizationRequest[] @relation("RequestCreator")
  resolvedRequests    OrganizationRequest[] @relation("RequestResolver")
  requestReads        RequestRead[]
  requestEvents       RequestEvent[]
  absences            EmployeeAbsence[]
  uploadedDocuments   Document[] @relation("DocumentUploader")
  personalDocuments   Document[] @relation("DocumentTarget")
  documentAcknowledgements DocumentAcknowledgement[] @relation("AcknowledgementRecipient")
  assignedAcknowledgements DocumentAcknowledgement[] @relation("AcknowledgementAssigner")

  @@unique([organizationId, userId])
  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([userId])
  @@index([organizationId, role])
  @@index([organizationId, leftAt])
  @@map("organization_members")
}

model WorkShift {
  locationId String @map("location_id") @db.Uuid
  location OrganizationLocation @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)
  id                   String                @id @default(uuid()) @db.Uuid
  organizationId       String                @map("organization_id") @db.Uuid
  memberId             String                @map("member_id") @db.Uuid
  createdByMemberId    String                @map("created_by_member_id") @db.Uuid
  scheduledStartAt     DateTime              @map("scheduled_start_at") @db.Timestamptz(3)
  scheduledEndAt       DateTime              @map("scheduled_end_at") @db.Timestamptz(3)
  breakMinutes         Int                   @default(0) @map("break_minutes")
  actualStartAt        DateTime?             @map("actual_start_at") @db.Timestamptz(3)
  actualEndAt          DateTime?             @map("actual_end_at") @db.Timestamptz(3)
  actualBreakMinutes   Int?                  @map("actual_break_minutes")
  positionId           String?               @map("position_id") @db.Uuid
  positionNameSnapshot String?               @map("position_name_snapshot") @db.VarChar(120)
  position             OrganizationPosition? @relation(fields: [positionId], references: [id], onDelete: SetNull)
  description          String?               @db.VarChar(500)
  status               WorkShiftStatus       @default(SCHEDULED)
  cancelledAt          DateTime?             @map("cancelled_at") @db.Timestamptz(3)
  cancelledByMemberId  String?               @map("cancelled_by_member_id") @db.Uuid
  cancellationReason   String?               @map("cancellation_reason") @db.VarChar(500)
  assignmentReadAt     DateTime?             @map("assignment_read_at") @db.Timestamptz(3)
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member            OrganizationMember    @relation("ShiftEmployee", fields: [memberId], references: [id], onDelete: Restrict)
  createdByMember   OrganizationMember    @relation("ShiftCreator", fields: [createdByMemberId], references: [id], onDelete: Restrict)
  cancelledByMember OrganizationMember?   @relation("ShiftCanceller", fields: [cancelledByMemberId], references: [id], onDelete: Restrict)
  adjustments       WorkShiftAdjustment[]
  changeRequests    OrganizationRequest[]
  notifications     AccountNotification[]

  @@index([organizationId, scheduledStartAt])
  @@index([organizationId, scheduledEndAt])
  @@index([organizationId, memberId, scheduledStartAt])
  @@index([memberId, scheduledStartAt])
  @@map("work_shifts")
  @@index([organizationId, locationId])
}

model RequestType {
  id                String             @id @default(uuid()) @db.Uuid
  organizationId    String             @map("organization_id") @db.Uuid
  name              String             @db.VarChar(100)
  description       String?            @db.VarChar(500)
  systemCode        RequestSystemCode? @map("system_code")
  dateMode          RequestDateMode    @map("date_mode")
  requiresComment   Boolean            @default(false) @map("requires_comment")
  allowsAttachments Boolean            @default(false) @map("allows_attachments")
  isActive          Boolean            @default(true) @map("is_active")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requests     OrganizationRequest[]

  @@unique([organizationId, systemCode])
  @@index([organizationId, isActive])
  @@map("request_types")
}

model OrganizationRequest {
  staffingRequestId String? @map("staffing_request_id") @db.Uuid
  staffingRequest OrganizationRequest? @relation("StaffingResponses", fields: [organizationId, staffingRequestId], references: [organizationId, id], onDelete: Restrict)
  staffingResponses OrganizationRequest[] @relation("StaffingResponses")
  staffingPositionId String? @map("staffing_position_id") @db.Uuid
  staffingPositionName String? @map("staffing_position_name") @db.VarChar(120)

  locationId String @map("location_id") @db.Uuid
  location OrganizationLocation @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)
  id                 String             @id @default(uuid()) @db.Uuid
  organizationId     String             @map("organization_id") @db.Uuid
  createdByMemberId  String             @map("created_by_member_id") @db.Uuid
  requestTypeId      String             @map("request_type_id") @db.Uuid
  typeNameSnapshot   String             @map("type_name_snapshot") @db.VarChar(100)
  systemCodeSnapshot RequestSystemCode? @map("system_code_snapshot")
  status             RequestStatus      @default(PENDING)
  startDate          DateTime?          @map("start_date") @db.Date
  endDate            DateTime?          @map("end_date") @db.Date
  comment            String?            @db.VarChar(2000)
  relatedShiftId     String?            @map("related_shift_id") @db.Uuid
  originalStartAt    DateTime?          @map("original_start_at") @db.Timestamptz(3)
  originalEndAt      DateTime?          @map("original_end_at") @db.Timestamptz(3)
  proposedStartAt    DateTime?          @map("proposed_start_at") @db.Timestamptz(3)
  proposedEndAt      DateTime?          @map("proposed_end_at") @db.Timestamptz(3)
  resolvedAt         DateTime?          @map("resolved_at") @db.Timestamptz(3)
  resolvedByMemberId String?            @map("resolved_by_member_id") @db.Uuid
  resolutionComment  String?            @map("resolution_comment") @db.VarChar(1000)
  cancelledAt        DateTime?          @map("cancelled_at") @db.Timestamptz(3)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization  Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator       OrganizationMember    @relation("RequestCreator", fields: [createdByMemberId], references: [id], onDelete: Restrict)
  requestType   RequestType           @relation(fields: [requestTypeId], references: [id], onDelete: Restrict)
  relatedShift  WorkShift?            @relation(fields: [relatedShiftId], references: [id], onDelete: Restrict)
  resolvedBy    OrganizationMember?   @relation("RequestResolver", fields: [resolvedByMemberId], references: [id], onDelete: Restrict)
  reads         RequestRead[]
  attachments   RequestAttachment[]
  events        RequestEvent[]
  absence       EmployeeAbsence?
  notifications AccountNotification[]

  @@index([organizationId, status, createdAt])
  @@index([createdByMemberId, status, createdAt])
  @@index([requestTypeId, createdAt])
  @@index([resolvedAt])
  @@unique([organizationId, id])
  @@unique([staffingRequestId, createdByMemberId])
  @@map("requests")
  @@index([organizationId, locationId])
}

model RequestRead {
  requestId String   @map("request_id") @db.Uuid
  memberId  String   @map("member_id") @db.Uuid
  readAt    DateTime @default(now()) @map("read_at") @db.Timestamptz(3)

  request OrganizationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  member  OrganizationMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([requestId, memberId])
  @@index([memberId, readAt])
  @@map("request_reads")
}

model RequestAttachment {
  id           String   @id @default(uuid()) @db.Uuid
  requestId    String   @map("request_id") @db.Uuid
  storedFileId String   @unique @map("stored_file_id") @db.Uuid
  fileName     String   @map("file_name") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  request    OrganizationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  storedFile StoredFile          @relation(fields: [storedFileId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
  @@map("request_attachments")
}

model RequestEvent {
  id            String           @id @default(uuid()) @db.Uuid
  requestId     String           @map("request_id") @db.Uuid
  actorMemberId String           @map("actor_member_id") @db.Uuid
  type          RequestEventType
  comment       String?          @db.VarChar(1000)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  request OrganizationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor   OrganizationMember  @relation(fields: [actorMemberId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
  @@map("request_events")
}

model EmployeeAbsence {
  reason String? @db.VarChar(32)
  comment String? @db.VarChar(500)
  id              String            @id @default(uuid()) @db.Uuid
  organizationId  String            @map("organization_id") @db.Uuid
  memberId        String            @map("member_id") @db.Uuid
  sourceRequestId String?           @unique @map("source_request_id") @db.Uuid
  type            RequestSystemCode
  startDate       DateTime          @map("start_date") @db.Date
  endDate         DateTime          @map("end_date") @db.Date
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  cancelledAt     DateTime?         @map("cancelled_at") @db.Timestamptz(3)

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedByMemberId String? @map("updated_by_member_id") @db.Uuid
  cancelledByMemberId String? @map("cancelled_by_member_id") @db.Uuid
  cancellationReason String? @map("cancellation_reason") @db.VarChar(500)
  notifications AccountNotification[]

  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member        OrganizationMember  @relation(fields: [memberId], references: [id], onDelete: Restrict)
  sourceRequest OrganizationRequest? @relation(fields: [sourceRequestId], references: [id], onDelete: Restrict)

  @@index([organizationId, startDate, endDate])
  @@index([memberId, startDate, endDate])
  @@map("employee_absences")
}

model WorkShiftAdjustment {
  id                   String   @id @default(uuid()) @db.Uuid
  shiftId              String   @map("shift_id") @db.Uuid
  changedByMemberId    String   @map("changed_by_member_id") @db.Uuid
  previousStartAt      DateTime @map("previous_start_at") @db.Timestamptz(3)
  previousEndAt        DateTime @map("previous_end_at") @db.Timestamptz(3)
  previousBreakMinutes Int      @map("previous_break_minutes")
  newStartAt           DateTime @map("new_start_at") @db.Timestamptz(3)
  newEndAt             DateTime @map("new_end_at") @db.Timestamptz(3)
  newBreakMinutes      Int      @map("new_break_minutes")
  reason               String   @db.VarChar(500)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  shift           WorkShift          @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  changedByMember OrganizationMember @relation("ShiftAdjustmentAuthor", fields: [changedByMemberId], references: [id], onDelete: Restrict)

  @@index([shiftId, createdAt])
  @@index([changedByMemberId])
  @@map("work_shift_adjustments")
}

model OrganizationInvite {
  locationId String? @map("location_id") @db.Uuid
  location OrganizationLocation? @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)
  id               String                 @id @default(uuid()) @db.Uuid
  organizationId   String                 @map("organization_id") @db.Uuid
  invitedByUserId  String                 @map("invited_by_user_id") @db.Uuid
  type             OrganizationInviteType
  invitedEmail     String?                @map("invited_email") @db.VarChar(254)
  codeCiphertext   String?                @map("code_ciphertext") @db.Text
  notificationHiddenAt DateTime?          @map("notification_hidden_at") @db.Timestamptz(3)
  tokenHash        String                 @unique @map("token_hash") @db.VarChar(64)
  expiresAt        DateTime               @map("expires_at") @db.Timestamptz(3)
  readAt           DateTime?              @map("read_at") @db.Timestamptz(3)
  acceptedByUserId String?                @map("accepted_by_user_id") @db.Uuid
  acceptedAt       DateTime?              @map("accepted_at") @db.Timestamptz(3)
  rejectedAt       DateTime?              @map("rejected_at") @db.Timestamptz(3)
  revokedAt        DateTime?              @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitationCreator", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  acceptedBy   User?        @relation("InvitationAcceptor", fields: [acceptedByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([invitedEmail, type, expiresAt])
  @@index([invitedEmail, createdAt, id])
  @@index([invitedByUserId])
  @@index([acceptedByUserId])
  @@map("organization_invites")
  @@index([organizationId, locationId])
}

model SensitiveActionToken {
  targetLocationId String? @map("target_location_id") @db.Uuid
  id             String              @id @default(uuid()) @db.Uuid
  userId         String              @map("user_id") @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  action         SensitiveActionType
  targetUserId   String?             @map("target_user_id") @db.Uuid
  codeHash       String              @unique @map("code_hash") @db.VarChar(64)
  expiresAt      DateTime            @map("expires_at") @db.Timestamptz(3)
  usedAt         DateTime?           @map("used_at") @db.Timestamptz(3)
  attempts       Int                 @default(0)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  user         User         @relation("SensitiveActionOwner", fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  targetUser   User?        @relation("SensitiveActionTarget", fields: [targetUserId], references: [id], onDelete: Restrict)

  @@index([userId, organizationId, action, usedAt])
  @@index([organizationId])
  @@index([targetUserId])
  @@map("sensitive_action_tokens")
}

model AuthSession {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  refreshTokenHash  String    @unique @map("refresh_token_hash") @db.VarChar(64)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  browserTokenHash  String?   @map("browser_token_hash") @db.VarChar(64)
  lastActiveAt      DateTime? @map("last_active_at") @db.Timestamptz(3)
  lastUsedAt        DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  idleExpiresAt     DateTime  @map("idle_expires_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  userAgent         String?   @map("user_agent") @db.VarChar(512)
  ipAddress         String?   @map("ip_address") @db.VarChar(45)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([browserTokenHash, revokedAt])
  @@index([userId, revokedAt])
  @@index([idleExpiresAt])
  @@map("auth_sessions")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  attempts  Int       @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
