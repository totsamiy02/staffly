  organizationId String           @map("organization_id") @db.Uuid
  name           String           @db.VarChar(120)
  isActive       Boolean          @default(true) @map("is_active")
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        MemberPosition[]
  templates      ShiftTemplate[]
  shifts         WorkShift[]

  @@unique([organizationId, name])
  @@map("organization_positions")
}

model MemberPosition {
  memberId   String               @map("member_id") @db.Uuid
  positionId String               @map("position_id") @db.Uuid
  member     OrganizationMember   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  position   OrganizationPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@id([memberId, positionId])
  @@map("member_positions")
}

model ShiftTemplate {
  locationId String @map("location_id") @db.Uuid
  location OrganizationLocation @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  positionId     String?               @map("position_id") @db.Uuid
  name           String                @db.VarChar(120)
  startTime      String                @map("start_time") @db.VarChar(5)
  endTime        String                @map("end_time") @db.VarChar(5)
  endDayOffset   Int                   @default(0) @map("end_day_offset")
  isActive       Boolean               @default(true) @map("is_active")
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  position       OrganizationPosition? @relation(fields: [positionId], references: [id], onDelete: Restrict)

