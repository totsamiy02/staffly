enum ShiftOfferMode {
  DISABLED
  AUTO
  APPROVAL
}

enum ShiftOfferKind {
  TRANSFER
  SWAP
}

enum ShiftOfferStatus {
  PENDING
  AWAITING_APPROVAL
  COMPLETED
  REJECTED
  CANCELLED
  EXPIRED
  INVALID
}

model ShiftOfferReservation {
  shiftId        String     @id @map("shift_id") @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  offerId        String     @map("offer_id") @db.Uuid
  shift          WorkShift  @relation(fields: [organizationId, shiftId], references: [organizationId, id], onDelete: Cascade)
  offer          ShiftOffer @relation(fields: [organizationId, offerId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, shiftId])
  @@index([offerId])
  @@map("shift_offer_reservations")
}

model ShiftOffer {
  id                 String                  @id @default(uuid()) @db.Uuid
  organizationId     String                  @map("organization_id") @db.Uuid
  locationId         String                  @map("location_id") @db.Uuid
  initiatorMemberId  String                  @map("initiator_member_id") @db.Uuid
  recipientMemberId  String?                 @map("recipient_member_id") @db.Uuid
  sourceShiftId      String                  @map("source_shift_id") @db.Uuid
  targetShiftId      String?                 @map("target_shift_id") @db.Uuid
  kind               ShiftOfferKind
  mode               ShiftOfferMode
  status             ShiftOfferStatus        @default(PENDING)
  sourceSnapshot     Json                    @map("source_snapshot")
  targetSnapshot     Json?                   @map("target_snapshot")
  comment            String?                 @db.VarChar(500)
  resolutionReason   String?                 @map("resolution_reason") @db.VarChar(500)
  acceptedByMemberId String?                 @map("accepted_by_member_id") @db.Uuid
  acceptedAt         DateTime?               @map("accepted_at") @db.Timestamptz(3)
  reviewedByMemberId String?                 @map("reviewed_by_member_id") @db.Uuid
  reviewedAt         DateTime?               @map("reviewed_at") @db.Timestamptz(3)
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  closedAt           DateTime?               @map("closed_at") @db.Timestamptz(3)
  organization       Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location           OrganizationLocation    @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)
  initiator          OrganizationMember      @relation("OfferInitiator", fields: [organizationId, initiatorMemberId], references: [organizationId, id], onDelete: Restrict)
  recipient          OrganizationMember?     @relation("OfferRecipient", fields: [organizationId, recipientMemberId], references: [organizationId, id], onDelete: Restrict)
  acceptedBy         OrganizationMember?     @relation("OfferAcceptor", fields: [organizationId, acceptedByMemberId], references: [organizationId, id], onDelete: Restrict)
  reviewedBy         OrganizationMember?     @relation("OfferReviewer", fields: [organizationId, reviewedByMemberId], references: [organizationId, id], onDelete: Restrict)
  sourceShift        WorkShift               @relation("OfferSource", fields: [organizationId, sourceShiftId], references: [organizationId, id], onDelete: Cascade)
  targetShift        WorkShift?              @relation("OfferTarget", fields: [organizationId, targetShiftId], references: [organizationId, id], onDelete: Cascade)
  reservations       ShiftOfferReservation[]
  notifications      AccountNotification[]

  @@unique([organizationId, id])
  @@index([organizationId, locationId, status, createdAt])
  @@index([initiatorMemberId, createdAt])
  @@index([recipientMemberId, status])
  @@map("shift_offers")
}

model AccessRole {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  name String @db.VarChar(80)
