{
  "name": "hr",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev:server": "prisma generate",
    "dev": "vite",
    "dev:server": "NODE_ENV=development tsx watch --exclude \"./src/generated/prisma/**\" --env-file=src/server/.env src/server/index.ts",
    "dev:all": "concurrently -k \"npm run dev:server\" \"tsx scripts/wait-for-api.ts && npm run dev\"",
    "start:server": "NODE_ENV=production tsx --env-file=src/server/.env src/server/index.ts",
    "prestart:server": "prisma generate",
    "prebuild": "node scripts/copy-pdf-assets.mjs && prisma generate",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:setup": "node --env-file=src/server/.env scripts/setup-test-db.mjs && PRISMA_ENV_FILE=src/server/.env.test prisma migrate deploy",
    "test": "node --import tsx tests/performance/load-test.mjs --tests=only",
    "storage:audit": "node --env-file=src/server/.env --import tsx scripts/storage-audit.ts",
    "predev": "node scripts/copy-pdf-assets.mjs",
    "start:worker": "NODE_ENV=production tsx --env-file=src/server/.env src/server/worker.ts",
    "load:test": "node --import tsx tests/performance/load-test.mjs",
    "test:isolated": "node --import tsx tests/performance/load-test.mjs --tests=only",
    "test:load": "node --import tsx tests/performance/load-test.mjs",
    "test:scale": "node --import tsx tests/performance/load-test.mjs --profile=scale --instances=4 --pool-budget=40 --heap-budget-mib=3072 --soak-seconds=180 --rate=200 --rotate-sessions=true --assert-slo=true",
    "test:edge": "node tests/security/check-edge.mjs",
    "test:db": "NODE_ENV=test node --env-file=src/server/.env.test scripts/run-tests.mjs",
    "db:backup": "node --import tsx scripts/database-backup.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1158.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tanstack/react-query": "^5.103.2",
    "argon2": "^0.45.1",
    "cfb": "^1.2.2",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^7.0.3",
    "docx-preview": "^0.4.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "jszip": "^3.10.2",
    "nodemailer": "^10.2.1",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.0",
    "pptx-preview": "^1.0.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "saxes": "^6.0.0",
    "sharp": "^0.35.5",
    "ssf": "^0.11.2",
    "tsx": "^4.23.15",
    "word-extractor": "^1.0.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "pptx-preview": {
      "uuid": "^11.1.1",
      "echarts": "^6.1.0"
    }
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.6",
    "oxlint": "^1.71.0",
    "prisma": "^7.10.1",
    "sass-embedded": "^1.100.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.5"
  }
}
