# Copy to src/server/.env. Do not put server secrets in VITE_* variables.
# Development: npm run dev:all; production: npm run start:server.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/staffly_dev?schema=public"
JWT_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
# Production admin access: independent restricted DB role and random secret.
# Development uses the local database owner and a purpose-separated JWT derivation.
ADMIN_DATABASE_URL=""
ADMIN_AUTH_SECRET=""
# Never put ADMIN_MANAGEMENT_DATABASE_URL, BACKUP_DATABASE_URL, RESTORE_DATABASE_URL or migration credentials in this file.
# Production operator commands use a separate private --env-file.
APP_ORIGIN="http://localhost:5173"
# Path is relative to the project working directory; use an absolute private path in production.
LOCAL_STORAGE_ROOT="./storage"
PORT="3001"
HOST="127.0.0.1"
# Production: run separate start:worker and set false in every API replica.
RUN_BACKGROUND_WORKERS="true"
API_WARMUP="false"
DB_POOL_MAX="10"
DB_CONNECT_TIMEOUT_MS="3000"
DB_STATEMENT_TIMEOUT_MS="15000"
# Trust only the actual proxy IP/CIDR. Never use true or a hop count.
TRUST_PROXY="false"
HTTP_IP_RATE="100"
HTTP_IP_BURST="500"
HTTP_MAX_INFLIGHT="256"
HTTP_MAX_UPLOADS="2"
HTTP_MAX_HEAVY="2"
HTTP_MAX_CONNECTIONS="20000"
AUTH_CRYPTO_CONCURRENCY="2"
METRICS_TOKEN=""
# LISTEN needs a direct/session-pooled connection when the main DB uses PgBouncer.
# LIVE_DATABASE_URL="postgresql://..."
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"
S3_ALLOW_INSECURE="false"
# Required for admin verification. Email contents/codes are never logged.
SMTP_HOST="smtp.yandex.ru"
SMTP_PORT="465"
SMTP_USER="your-test-mailbox@yandex.ru"
SMTP_APP_PASSWORD="your-yandex-app-password"

# Optional stable secret (32+ characters) for encrypted invitation codes. Defaults to JWT_SECRET.
# INVITE_CODE_SECRET="replace-with-a-stable-random-secret"

# Optional Yandex ID. Server-only: never use VITE_* for these values.
# Use a separate OAuth application and HTTPS callback for production.
YANDEX_CLIENT_ID=""
YANDEX_CLIENT_SECRET=""
YANDEX_REDIRECT_URI="http://localhost:5173/api/auth/yandex/callback"

# Final personal/organization and expired security-log cleanup stays disabled.
# Review data:retention dry-run, archive holds, and backup lifecycle before enabling.
DATA_PURGE_ENABLED="false"
# Emergency mail pause: restart every API replica and worker after changing.
EMAIL_DELIVERY_PAUSED="false"

# Optional release metadata: version/revision and actual deployment time in ISO 8601.
APP_ENVIRONMENT=development
APP_VERSION=
APP_DEPLOYED_AT=

# Operator-only maintenance process. Never give these URLs/paths to the HTTP API.
ADMIN_MANAGEMENT_DATABASE_URL=""
BACKUP_DATABASE_URL=""
ADMIN_BACKUP_DIRECTORY=""
ADMIN_FILES_BACKUP_DIRECTORY=""
# Separate persistent volume, outside the database and file snapshot directories.
ADMIN_DELETION_LEDGER_DIRECTORY=""
# Isolated rehearsal cluster, operator role with CREATEDB; never a web-supplied target.
RESTORE_ADMIN_DATABASE_URL=""
# Independent observer is optional and disabled in the panel by default.
ADMIN_OBSERVER_DATABASE_URL=""
ADMIN_OBSERVER_STATE_DIRECTORY=""
ADMIN_PROBE_URL=""
ADMIN_SIGNAL_WEBHOOK_URL=""
ADMIN_SIGNAL_WEBHOOK_TOKEN=""
ADMIN_SIGNAL_TELEGRAM_TOKEN=""
